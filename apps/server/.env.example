# Copy this to .env and fill in the values

# PostgreSQL connection (provided by Railway Postgres plugin)
DATABASE_URL=postgres://forum:forum@localhost:5433/forum

# API server port
PORT=3001

# JWT signing secret — use a long random string in production
JWT_SECRET=change-this-to-a-random-secret

# Set to "production" to disable the /dev/token endpoint
NODE_ENV=development
